@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <pre>@Model.Message</pre>

    @if (!Model.ModelState.IsValid)
    {
        foreach(var err in Model.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div class="alert alert-danger">@err.ErrorMessage</div>
        }
    }

    <p>Speech to Text</p>
    <div class="container">
        <form method="post" enctype="multipart/form-data">
            CallID: <input asp-for="@Model.VssCallId" type="text" readonly />
            <input type="file" id="UploadedFile" name="UploadedFile" />
            <button type="submit">Upload</button>
        </form>
    </div>
</div>
<div class="container">
    <div class="row p-1">
        <div class="col">
            <hr />
        </div>
    </div>
    <div class="row p-1">
        <div class="col">
            <div class="alert alert-info" role="alert" id="recognizingText" />
        </div>
    </div>
    <div class="row p-1">
        <div class="col">
            <ul class="list-group" id="recognizedText"></ul>
        </div>
    </div>
</div>
<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/transcription.js"></script>